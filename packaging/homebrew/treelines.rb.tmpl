class Treelines < Formula
  desc "Local code-intelligence CLI for Go, Python, and Rust"
  homepage "https://github.com/rpcarvs/treelines"
  license "GPL-3.0-only"
  version "__VERSION__"

  on_macos do
    url "https://github.com/rpcarvs/treelines/releases/download/v__VERSION__/treelines___VERSION___darwin_arm64.tar.gz"
    sha256 "__DARWIN_ARM64_SHA256__"
  end

  on_linux do
    url "https://github.com/rpcarvs/treelines/releases/download/v__VERSION__/treelines___VERSION___linux_amd64.tar.gz"
    sha256 "__LINUX_AMD64_SHA256__"
  end

  def install
    bin.install "treelines"
  end

  test do
    system "#{bin}/treelines", "-v"
  end
end
